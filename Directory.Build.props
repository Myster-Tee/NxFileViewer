<Project>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Keep file names and line numbers without embedding the checkout location. -->
    <PathMap Condition="'$(PathMap)' != ''">$(PathMap),$(MSBuildThisFileDirectory)=/_/NxFileViewer/</PathMap>
    <PathMap Condition="'$(PathMap)' == ''">$(MSBuildThisFileDirectory)=/_/NxFileViewer/</PathMap>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
