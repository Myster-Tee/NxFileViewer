<UserControl x:Class="Emignatik.NxFileViewer.Views.Windows.NandView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:Emignatik.NxFileViewer.Localization">
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_Tip}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <WrapPanel Grid.Row="1" Margin="0,0,0,12">
   <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_Open}" Command="{Binding OpenCommand}" Padding="12,5" Margin="0,0,12,0" Visibility="{Binding IsStandalone, Converter={StaticResource FalseToCollapseVisibilityConverter}}"/>
   <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_Info}" Command="{Binding ReadInformationCommand}" Padding="12,5" Margin="0,0,12,0"/>
   <ComboBox ItemsSource="{Binding Partitions}" SelectedItem="{Binding SelectedPartition}" MinWidth="210" Margin="0,0,12,0" IsEnabled="{Binding Runner.IsRunning, Converter={StaticResource BoolInverterConverter}}"/>
   <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_Export}" Command="{Binding ExportCommand}" Padding="12,5" Margin="0,0,12,0"/>
   <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.CancelAction}" Command="{Binding Runner.CancelCommand}" Padding="12,5"/>
  </WrapPanel>
  <TextBlock Grid.Row="2" Text="{Binding Source}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <TextBox Grid.Row="3" Text="{Binding Information, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
 </Grid>
</UserControl>
