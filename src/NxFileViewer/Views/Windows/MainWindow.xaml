<Window x:Class="Emignatik.NxFileViewer.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Emignatik.NxFileViewer.Localization"
        xmlns:dragAndDrop="clr-namespace:Emignatik.NxFileViewer.Utils.MVVM.BindingExtensions.DragAndDrop"
        xmlns:customControls="clr-namespace:Emignatik.NxFileViewer.Views.CustomControls"
        xmlns:userControls="clr-namespace:Emignatik.NxFileViewer.Views.UserControls"
        xmlns:windows="clr-namespace:Emignatik.NxFileViewer.Views.Windows"
        mc:Ignorable="d"
        AllowDrop="True"
        Style="{StaticResource WindowStyle}"
        Title="{Binding Path=Title}" Height="850" Width="1400" MinHeight="600" MinWidth="1000" d:DataContext="{d:DesignInstance windows:MainWindowViewModel}"
        dragAndDrop:DropFilesBehaviorExtension.IsEnabled="True">

    <Window.Resources>
        <DrawingImage x:Key="NandIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <!-- RAM-style memory board, chips and gold contacts. -->
                    <GeometryDrawing Brush="#348A68" Geometry="M1,1 L31,1 31,12 19,12 19,15 16,15 16,12 1,12 Z">
                        <GeometryDrawing.Pen><Pen Brush="#205A45" Thickness="1"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#263747" Geometry="M4,3 H10 V10 H4 Z M13,3 H19 V10 H13 Z M22,3 H28 V10 H22 Z"/>
                    <GeometryDrawing Brush="#E5BD60" Geometry="M3,12 H5 V15 H3 Z M7,12 H9 V15 H7 Z M11,12 H13 V15 H11 Z M21,12 H23 V15 H21 Z M25,12 H27 V15 H25 Z M29,12 H31 V15 H29 Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding Path=OpenFileCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding Path=OpenLastFileCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding Path=CloseFileCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding Path=VerifyNcasIntegrityCommand}" />
        <KeyBinding Gesture="F10" Command="{Binding Path=LoadKeysCommand}" />
        <KeyBinding Gesture="F9" Command="{Binding Path=OpenTitleWebPageCommand}" />
        <KeyBinding Gesture="F2" Command="{Binding Path=ShowRenameToolWindowCommand}" />
        <KeyBinding Gesture="Alt+S" Command="{Binding Path=ShowSettingsWindowCommand}" />
    </Window.InputBindings>

    <Grid Cursor="">
        <Grid.RowDefinitions>
            <!-- Menu -->
            <RowDefinition Height="Auto" />
            <!-- Content -->
            <RowDefinition Height="*" />
            <!-- Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>



        <TabControl x:Name="WorkspaceTabs" Grid.Row="1" SelectionChanged="WorkspaceSelectionChanged">
            <TabItem x:Name="HomeTab">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="/Styling/Icons/FolderDirectoryEntryItem.png" Width="16" Height="16" Margin="0,0,7,0"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Workspace_Home}" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="960">
                    <Image Source="/Styling/Icons/Icon.ico" Width="72" Height="72" Margin="0,0,0,16"/>
                    <TextBlock Text="NxFileViewer" FontSize="30" Margin="0,0,0,24" HorizontalAlignment="Center"/>
                    <Border BorderBrush="{DynamicResource FontBrush.Warning}" BorderThickness="1" Padding="12" Margin="0,0,0,12"
                            Visibility="{Binding HasProdKeysProblems, Converter={StaticResource FalseToCollapseVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="⚠ prod.keys" Foreground="{DynamicResource FontBrush.Warning}" FontWeight="Bold"/>
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,6">
                                <TextBlock Text="{Binding ProdKeysValidationSummary}" TextWrapping="Wrap"/>
                            </ScrollViewer>
                            <WrapPanel>
                                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Title}" Command="{Binding ShowSettingsWindowCommand}" Padding="12,5" Margin="0,0,8,0"/>
                                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_ReloadKeys}" Command="{Binding LoadKeysCommand}" Padding="12,5"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ViewerUpdates.AvailableUpdates}" Visibility="{Binding ViewerUpdates.AvailableUpdates, Converter={StaticResource StringNullOrEmptyToCollapsedVisibilityConverter}}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Update_Install}" Command="{Binding ViewerUpdates.InstallCommand}" Visibility="{Binding ViewerUpdates.HasViewerUpdate, Converter={StaticResource FalseToCollapseVisibilityConverter}}" Padding="12,5" Margin="0,0,0,12"/>
                    <WrapPanel HorizontalAlignment="Center">
                    <Button Click="NavigateFile" Padding="12,10" Margin="4,5"><StackPanel Orientation="Horizontal"><Image Source="/Styling/Icons/open_16x16.png" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Workspace_File}" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Click="NavigateBatch" Padding="12,10" Margin="4,5"><StackPanel Orientation="Horizontal"><Image Source="/Styling/Icons/safe_16x16.png" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchIntegrity_Title}" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Click="NavigateRename" Padding="12,10" Margin="4,5"><StackPanel Orientation="Horizontal"><Image Source="/Styling/Icons/rename_16x16.png" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.RenamingTool_WindowTitle}" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="HomeNandButton" Click="NavigateNand" Padding="12,10" Margin="4,5"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource NandIcon}" Width="24" Height="20" Margin="0,0,12,0"/><TextBlock Text="NAND" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Click="NavigateSettings" Padding="12,10" Margin="4,5"><StackPanel Orientation="Horizontal"><Image Source="/Styling/Icons/settings_16x16.png" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Title}" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Click="NavigatePlugins" Padding="12,10" Margin="4,5"><StackPanel Orientation="Horizontal"><Image Source="/Styling/Icons/settings_16x16.png" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Workspace_Plugins}" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Click="NavigateUpdates" Padding="12,10" Margin="4,5"><StackPanel Orientation="Horizontal"><Image Source="/Styling/Icons/refresh_16x16.png" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.DataUpdate_Title}" VerticalAlignment="Center"/></StackPanel></Button>
                    </WrapPanel>
                    <WrapPanel x:Name="HomePluginRow" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button x:Name="NandGuiButton" Command="{Binding NandPlugin.OpenGuiCommand}" Padding="20,12" Margin="4,5"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource NandIcon}" Width="24" Height="20" Margin="0,0,10,0"/><TextBlock Text="NxNandManager GUI" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NszGuiButton" Content="NSZ GUI" Command="{Binding Nsz.OpenGuiCommand}" Padding="20,12" Margin="4,5"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="FileTab">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="/Styling/Icons/open_16x16.png" Width="16" Height="16" Margin="0,0,7,0"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Workspace_File}" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="8,8,8,0">
                        <Button Command="{Binding OpenFileCommand}" IsEnabled="{Binding BackgroundTaskRunner.IsRunning, Converter={StaticResource BoolInverterConverter}}" Padding="12,4" Margin="0,0,8,0" ToolTip="Ctrl+O"><StackPanel Orientation="Horizontal"><Image Source="/Styling/Icons/open_16x16.png" Width="16" Height="16" Margin="0,0,7,0"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_Open}" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Command="{Binding OpenLastFileCommand}" IsEnabled="{Binding BackgroundTaskRunner.IsRunning, Converter={StaticResource BoolInverterConverter}}" Padding="12,4" Margin="0,0,8,0" ToolTip="Ctrl+Shift+O"><StackPanel Orientation="Horizontal"><Image Source="/Styling/Icons/reload_last_16x16.png" Width="16" Height="16" Margin="0,0,7,0"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_OpenLast}" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Command="{Binding CloseFileCommand}" IsEnabled="{Binding BackgroundTaskRunner.IsRunning, Converter={StaticResource BoolInverterConverter}}" Padding="12,4" Margin="0,0,8,0" ToolTip="Ctrl+Shift+C"><StackPanel Orientation="Horizontal"><Image Source="/Styling/Icons/close_16x16.png" Width="16" Height="16" Margin="0,0,7,0"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_Close}" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Command="{Binding VerifyNcasIntegrityCommand}" Padding="12,4" Margin="0,0,8,0" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_CheckIntegrity}"/>
                        <Button Command="{Binding Nsz.CompressCommand}" Padding="12,4" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Image Source="/Styling/Icons/NspItem.png" Width="16" Height="16" Margin="0,0,7,0"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nsz_Compress}" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Command="{Binding Nsz.DecompressCommand}" Padding="12,4" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Image Source="/Styling/Icons/NspItem.png" Width="16" Height="16" Margin="0,0,7,0"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nsz_Decompress}" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Command="{Binding OpenTitleWebPageCommand}" Padding="12,4" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Image Source="/Styling/Icons/navigate_16x16.png" Width="16" Height="16" Margin="0,0,7,0"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_OpenTitleWebPage}" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.CancelAction}"
                            Command="{Binding BackgroundTaskRunner.CancelCommand}" Margin="0" Padding="12,4"
                            Visibility="{Binding BackgroundTaskRunner.IsRunning, Converter={StaticResource FalseToCollapseVisibilityConverter}}"/>
                    </WrapPanel>
                    <ComboBox Grid.Row="1" ItemsSource="{Binding ArchiveEntries}" SelectedItem="{Binding SelectedArchiveEntry}" Margin="8"
                              HorizontalAlignment="Left" MaxWidth="650"
                              Visibility="{Binding HasArchiveEntries, Converter={StaticResource FalseToCollapseVisibilityConverter}}"/>
                    <Grid Grid.Row="2">
        <StackPanel  HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource WatermarkText}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.DragMeAFile}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding Path=NoProdKeysLoaded, Converter={StaticResource FalseToCollapseVisibilityConverter}}">
                <TextBlock Foreground="{DynamicResource FontBrush.Warning}">⚠</TextBlock>
                <TextBlock  Margin="5,0,0,0">
                    <Hyperlink Foreground="{DynamicResource FontBrush.Warning}" Command="{Binding ShowSettingsWindowCommand}">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.WarnNoProdKeysFileFound}" />
                    </Hyperlink>
                </TextBlock>
                <customControls:TipLabel ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_ToolTip_Keys}"/>
            </StackPanel>
        </StackPanel>
        <ContentControl  Content="{Binding Path=OpenedFile, Mode=TwoWay}"
                            ContentTemplateSelector="{StaticResource OpenedFileDataTemplateSelector}" />

                    </Grid>

                </Grid>
            </TabItem>
            <TabItem x:Name="BatchTab">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="/Styling/Icons/safe_16x16.png" Width="16" Height="16" Margin="0,0,7,0"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchIntegrity_Title}" VerticalAlignment="Center"/></StackPanel></TabItem.Header></TabItem>
            <TabItem x:Name="RenameTab">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="/Styling/Icons/rename_16x16.png" Width="16" Height="16" Margin="0,0,7,0"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.RenamingTool_WindowTitle}" VerticalAlignment="Center"/></StackPanel></TabItem.Header></TabItem>
            <TabItem x:Name="NandTab"><TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource NandIcon}" Width="20" Height="16" Margin="0,0,7,0"/><TextBlock Text="NAND" VerticalAlignment="Center"/></StackPanel></TabItem.Header></TabItem>
            <TabItem x:Name="SettingsTab">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="/Styling/Icons/settings_16x16.png" Width="16" Height="16" Margin="0,0,7,0"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Title}" VerticalAlignment="Center"/></StackPanel></TabItem.Header></TabItem>
            <TabItem x:Name="LogTab">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="/Styling/Icons/FileDirectoryEntryItem.png" Width="16" Height="16" Margin="0,0,7,0"/><TextBlock Text="Log" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                <userControls:LoggingView Margin="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" LogSource="{Binding LogSource, Mode=OneWay}" />
            </TabItem>
            <TabItem Visibility="Collapsed" x:Name="PluginsTab">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="/Styling/Icons/settings_16x16.png" Width="16" Height="16" Margin="0,0,7,0"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Workspace_Plugins}" VerticalAlignment="Center"/></StackPanel></TabItem.Header></TabItem>
            <TabItem Visibility="Collapsed" x:Name="UpdatesTab">
                <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="/Styling/Icons/refresh_16x16.png" Width="16" Height="16" Margin="0,0,7,0"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.DataUpdate_Title}" VerticalAlignment="Center"/></StackPanel></TabItem.Header></TabItem>
            <TabItem x:Name="InfoTab">
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="ⓘ" Margin="0,0,7,0"/><TextBlock Text="Info"/></StackPanel></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="900" HorizontalAlignment="Left">
                        <Image Source="/Styling/Icons/Icon.ico" Width="72" Height="72" HorizontalAlignment="Left" Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding ProgramVersion}" FontSize="28" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding ProgramArchitecture}" FontWeight="Bold" Margin="0,0,12,0"/>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Info_WithoutRuntime}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasBundledRuntime}" Value="True">
                                                <Setter Property="Text" Value="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Info_WithRuntime}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Info_Description}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <TextBlock Text="GitHub: sandmaennchen5/fork_NxFileViewer" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Info_Shortcuts}" Style="{StaticResource Title2}" Margin="0,16,0,12"/>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Ctrl+O" Width="160" FontWeight="Bold"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_Open}"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Ctrl+Shift+O" Width="160" FontWeight="Bold"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_OpenLast}"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Ctrl+Shift+C" Width="160" FontWeight="Bold"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_Close}"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="F5" Width="160" FontWeight="Bold"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_CheckIntegrity}"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="F9" Width="160" FontWeight="Bold"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_OpenTitleWebPage}"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="F10" Width="160" FontWeight="Bold"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_ReloadKeys}"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="F2" Width="160" FontWeight="Bold"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_ShowRenameToolWindow}"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Alt+S" Width="160" FontWeight="Bold"/><TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Title}"/></DockPanel>
                    </StackPanel></ScrollViewer></TabItem>

        </TabControl>


        <StatusBar Grid.Row="2">
            <!-- Status Text -->
            <StatusBarItem VerticalAlignment="Center">
                <TextBlock Text="{Binding Path=BackgroundTaskRunner.ProgressText, FallbackValue=Ready.}" ToolTip="{Binding Path=BackgroundTaskRunner.ProgressText, FallbackValue=Ready.}" />
            </StatusBarItem>

            <!-- Missing Keys Icon -->
            <StatusBarItem DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Visibility="{Binding Path=OpenedFile.FileOverview.MissingKeys, FallbackValue=Collapsed, Converter={StaticResource StringNullOrEmptyToCollapsedVisibilityConverter}}">
                <StatusBarItem.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ShowSettingsWindowCommand}" />
                </StatusBarItem.InputBindings>
                <StatusBarItem.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_CopyTextToClipboard}"
                                  Command="{Binding Path=OpenedFile.FileOverview.CopyMissingKeysCommand, FallbackValue={x:Null}}" />
                    </ContextMenu>
                </StatusBarItem.ContextMenu>
                <Label Style="{StaticResource KeyWarningIcon}"
                       ToolTip="{Binding Path=OpenedFile.FileOverview.MissingKeys, FallbackValue={x:Null}}" />
            </StatusBarItem>

            <!-- Prod.keys missing Icon -->
            <StatusBarItem DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Visibility="{Binding Path=NoProdKeysLoaded, Converter={StaticResource FalseToCollapseVisibilityConverter}}">
                <StatusBarItem.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ShowSettingsWindowCommand}" />
                </StatusBarItem.InputBindings>
                <Label Style="{StaticResource KeyErrorIcon}"
                       ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.WarnNoProdKeysFileFound}" />
            </StatusBarItem>

            <!-- Progress Bar -->
            <StatusBarItem DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <customControls:ProgressBarExt Width="80" Minimum="0" Maximum="100"
                                               Visibility="{Binding Path=BackgroundTaskRunner.IsRunning, Mode=OneWay, Converter={StaticResource FalseToCollapseVisibilityConverter}}"
                                               Value="{Binding Path=BackgroundTaskRunner.ProgressValue, Mode=OneWay, FallbackValue=70}"
                                               ValueText="{Binding Path=BackgroundTaskRunner.ProgressValueText, Mode=OneWay, FallbackValue=70%}"
                                               IsIndeterminate="{Binding Path=BackgroundTaskRunner.IsIndeterminate, Mode=OneWay, FallbackValue=True}">

                    <customControls:ProgressBarExt.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding BackgroundTaskRunner.CancelCommand}" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.CancelAction}" />
                        </ContextMenu>
                    </customControls:ProgressBarExt.ContextMenu>

                </customControls:ProgressBarExt>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
