<UserControl x:Class="Emignatik.NxFileViewer.Views.Windows.BatchIntegrityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Emignatik.NxFileViewer.Localization"
        xmlns:customControls="clr-namespace:Emignatik.NxFileViewer.Views.CustomControls"
        xmlns:userControls="clr-namespace:Emignatik.NxFileViewer.Views.UserControls">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding InputDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchIntegrity_Browse}" Command="{Binding BrowseCommand}" Padding="14,3"/>
            <Button Grid.Column="2" Margin="8,0,0,0" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Firmware_BrowseZip}" Command="{Binding BrowseFirmwareZipCommand}" Padding="14,3"/>
        </Grid>
        <WrapPanel Grid.Row="1" Margin="0,8">
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchTable_Search}" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Width="180" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding FileTypeFilters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FileTypeFilter}" Width="95" Margin="0,0,8,0"
                      ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchIntegrity_FileType}"/>
            <ComboBox ItemsSource="{Binding IntegrityFilters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding IntegrityFilter}" Width="120" Margin="0,0,8,0"
                      ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Title_FileInfo_Integrity}"/>
            <ComboBox ItemsSource="{Binding NamingFilters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NamingFilter}" Width="135" Margin="0,0,8,0"
                      ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchNaming_Title}"/>
            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchTable_ResetFilters}" Command="{Binding ResetFiltersCommand}" Padding="10,3" Margin="0,0,8,0"/>
            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchTable_Columns}" Click="OpenColumns" Padding="10,3" Margin="0,0,8,0"/>
            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchTable_ResetSort}" Click="ResetSort" Padding="10,3"/>
            <Grid Margin="18,0,0,0" VerticalAlignment="Center">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CheckBox Grid.Row="0" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Batch_IncludeArchives}" IsChecked="{Binding IncludeArchives}" Margin="0,0,18,2"/>
                <CheckBox Grid.Row="1" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchIntegrity_IncludeSubdirectories}" IsChecked="{Binding IncludeSubdirectories}" Margin="0,0,18,0"/>
                <CheckBox Grid.Column="1" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchIntegrity_ShowOnlyErrors}" IsChecked="{Binding ShowOnlyErrors}"/>
            </Grid>
        </WrapPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="ResultsGrid" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" MinColumnWidth="80" PreviewMouseWheel="ScrollTable" CanUserSortColumns="True" CanUserReorderColumns="True" EnableColumnVirtualization="True" ItemsSource="{Binding ResultsView}" SelectedItem="{Binding SelectedResult}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="OpenFileActions"/>
                        <Setter Property="ToolTip" Value="{Binding Diagnostic}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMissingKeys}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource FontBrush.Error}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchIntegrity_File}" Binding="{Binding FileName}" Width="220"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchIntegrity_FileType}" Binding="{Binding FileType}" Width="110"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchIntegrity_PackageType}" Binding="{Binding PackageType}" Width="110"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.PackageStructure_Title}" Binding="{Binding Structure}" Width="110"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Title_FileInfo_Compression}" Binding="{Binding Compression}" Width="110"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Title_FileInfo_Integrity}" Binding="{Binding Integrity}" Width="110"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchIntegrity_Path}" Binding="{Binding FilePath}" Width="260"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchIntegrity_Error}" Binding="{Binding Error}" Width="220"/>
                    <DataGridTextColumn Header="NSZ" Binding="{Binding ConversionStatus}" Width="220"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nsz_SourceSize}" Binding="{Binding SourceSize, StringFormat={}{0:N0}}" Width="110"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nsz_OutputSize}" Binding="{Binding OutputSize, StringFormat={}{0:N0}}" Width="110"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.AppTitle}" Binding="{Binding Title}" SortMemberPath="Title" Width="150" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.CnmtOverview_TitleId}" Binding="{Binding TitleId}" SortMemberPath="TitleId" Width="150" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Publisher}" Binding="{Binding Publisher}" SortMemberPath="Publisher" Width="150" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.CnmtOverview_TitleVersion}" Binding="{Binding Version}" SortMemberPath="VersionNumber" Width="150" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.DisplayVersion}" Binding="{Binding DisplayVersion}" SortMemberPath="DisplayVersion" Width="150" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.CnmtOverview_MinimumSystemVersion}" Binding="{Binding SystemVersion}" SortMemberPath="SystemVersion" Width="150" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.CnmtOverview_MasterKey}" Binding="{Binding MasterKey}" SortMemberPath="MasterKey" Width="150" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.CnmtOverview_BuildID}" Binding="{Binding BuildId}" SortMemberPath="BuildId" Width="150" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.CnmtOverview_Distribution}" Binding="{Binding Distribution}" SortMemberPath="Distribution" Width="150" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.AvailableLanguages}" Binding="{Binding Languages}" SortMemberPath="Languages" Width="150" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.FileInfo_FileSize}" Binding="{Binding FileSize, StringFormat={}{0:N0}}" SortMemberPath="FileSize" Width="110" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.FileInfo_CompressionRatio}" Binding="{Binding CompressionRatio, StringFormat={}{0:P1}}" SortMemberPath="CompressionRatio" Width="110" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchNaming_Title}" Binding="{Binding NamingStatus}" Width="110"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.RenamingTool_NewName}" Binding="{Binding ProposedPath}" Width="260" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchNaming_Error}" Binding="{Binding NamingError}" Width="220" Visibility="Collapsed"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
            <TabControl x:Name="DetailsTabs" Grid.Column="2" Margin="8,0,0,0" SelectedIndex="{Binding SelectedDetailsTabIndex, Mode=TwoWay}">
                <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.TabOverview}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <userControls:FileOverviewView DataContext="{Binding PreviewOverview}">
                                <userControls:FileOverviewView.Style>
                                    <Style TargetType="userControls:FileOverviewView" BasedOn="{StaticResource UserControlStyle}">
                                        <Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </userControls:FileOverviewView.Style>
                            </userControls:FileOverviewView>
                            <GroupBox Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchHistory_Title}"
                                      Visibility="{Binding ShowStoredOverview, Converter={StaticResource FalseToCollapseVisibilityConverter}}">
                                <StackPanel>
                                    <TextBox Text="{Binding SelectedResult.FilePath, Mode=OneWay}" Style="{StaticResource ReadOnlyTextBox}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <ItemsControl x:Name="StoredOverviewFields" ItemsSource="{Binding StoredOverviewFields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Key}" Style="{StaticResource Title2}"/>
                                                    <TextBox Text="{Binding Value, Mode=OneWay}" Style="{StaticResource ReadOnlyTextBox}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Firmware_Title}">
                    <TextBox Text="{Binding SelectedResult.FirmwareDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </TabItem>
                <TabItem Header="NAND">
                    <TextBox Text="{Binding SelectedResult.NandDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </TabItem>
            </TabControl>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
        <WrapPanel>
            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Batch_Scan}" Command="{Binding StartCommand}" Padding="12,4" Margin="0,0,8,8"/>
            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Batch_ScanAndVerify}" Command="{Binding ScanAndVerifyCommand}" Padding="12,4" Margin="0,0,8,8"/>
            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Batch_VerifyAll}" Command="{Binding VerifyAllCommand}" Padding="12,4" Margin="0,0,8,8"/>
            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nsz_CompressValid}" Command="{Binding CompressValidCommand}" Padding="12,4" Margin="0,0,8,8"/>
            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nsz_DecompressValid}" Command="{Binding DecompressValidCommand}" Padding="12,4" Margin="0,0,8,8"/>
            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchIntegrity_MoveValid}" Command="{Binding MoveValidCommand}" Padding="12,4" Margin="0,0,8,8"/>
        </WrapPanel>
        <WrapPanel>
            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchIntegrity_Export}" Command="{Binding ExportCommand}" Padding="12,4" Margin="0,0,8,8"/>
            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchNaming_Check}" Command="{Binding CheckNamingCommand}" Padding="12,4" Margin="0,0,8,8"/>
            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchNaming_RenameAll}" Command="{Binding RenameAllCommand}" Padding="12,4" Margin="0,0,8,8"/>
            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.CancelAction}" Command="{Binding BackgroundTask.CancelCommand}" Padding="12,4" Margin="0,0,8,8"/>
        </WrapPanel>
        </StackPanel>
        <DockPanel Grid.Row="4" Margin="0,10,0,0" Visibility="{Binding IsHistoryEnabled, Converter={StaticResource FalseToCollapseVisibilityConverter}}">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchHistory_Title}"/>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,4" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchHistory_Resume}" Command="{Binding ResumeHistoryCommand}"/>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,4" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchHistory_Show}" Command="{Binding LoadHistoryCommand}"/>
            <ComboBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" DisplayMemberPath="Label" IsEnabled="{Binding BackgroundTask.IsRunning, Converter={StaticResource BoolInverterConverter}}"/>
        </DockPanel>    </Grid>
</UserControl>
