<UserControl x:Class="Emignatik.NxFileViewer.Views.UserControls.OpenedFileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:Emignatik.NxFileViewer.Localization"
             xmlns:userControls="clr-namespace:Emignatik.NxFileViewer.Views.UserControls"
             xmlns:windows="clr-namespace:Emignatik.NxFileViewer.Views.Windows"
             mc:Ignorable="d"
             Style="{StaticResource UserControlStyle}"
             Background="{DynamicResource Surface.Static.Background}"
             d:DesignHeight="500" d:DesignWidth="400" d:DataContext="{d:DesignInstance userControls:OpenedFileViewModel}">
    <TabControl SelectedIndex="{Binding InitialDetailsTabIndex, Mode=OneWay}" Background="{DynamicResource Surface.Static.Background}" BorderBrush="{DynamicResource Control.Static.Border}">
        <TabItem>
            <TabItem.Style><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Style.Triggers><DataTrigger Binding="{Binding IsSpecialFile}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TabItem.Style>
            <TabItem.Header>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.TabOverview}" ToolTip="{Binding Path=FilePath}">
                    <TextBlock.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.ContextMenu_OpenFileLocation}"
                                      Command="{Binding Path=OpenFileLocationCommand}" />
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
            </TabItem.Header>
            <userControls:FileOverviewView DataContext="{Binding Path=FileOverview}"/>
        </TabItem>
        <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.TabContent}">
            <TabItem.Style><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Style.Triggers><DataTrigger Binding="{Binding IsSpecialFile}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TabItem.Style>
            <userControls:ContentView DataContext="{Binding Path=Content}"/>
        </TabItem>
        <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Firmware_Title}">
            <TabItem.Style><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasFirmwareInfo}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TabItem.Style>
            <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Firmware_Versions}" FontWeight="Bold"/>
                <TextBox Grid.Row="1" Text="{Binding FirmwareVersion, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8"/>
                <TextBox Grid.Row="2" Text="{Binding FirmwareDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </TabItem>
        <TabItem Header="NAND" Visibility="{Binding IsNand, Converter={StaticResource FalseToCollapseVisibilityConverter}}">
            <windows:NandView DataContext="{Binding Nand}"/>
        </TabItem>
    </TabControl>
</UserControl>
