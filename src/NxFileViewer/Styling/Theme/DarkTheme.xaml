<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         DARK THEME
         Must define exactly the same keys as LightTheme.xaml.
         ============================================================ -->

    <Color x:Key="AccentColor">#51EBAB</Color>
    <Color x:Key="WarningColor">#FFB454</Color>
    <Color x:Key="ErrorColor">#FF6B68</Color>

    <!-- Fonts -->
    <SolidColorBrush x:Key="FontBrush.Default" Color="#E6E6E6" />
    <SolidColorBrush x:Key="FontBrush.Success" Color="#6BC46D" />
    <SolidColorBrush x:Key="FontBrush.Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="FontBrush.Error" Color="{StaticResource ErrorColor}" />

    <!-- Windows and surfaces -->
    <SolidColorBrush x:Key="Window.Static.Background" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Window.Static.Foreground" Color="#E6E6E6" />
    <SolidColorBrush x:Key="Surface.Static.Background" Color="#252526" />

    <!-- Generic controls -->
    <SolidColorBrush x:Key="Control.Static.Background" Color="#333337" />
    <SolidColorBrush x:Key="Control.Static.Foreground" Color="#E6E6E6" />
    <SolidColorBrush x:Key="Control.Static.Border" Color="#4A4A4F" />
    <SolidColorBrush x:Key="Control.MouseOver.Background" Color="#3E3E42" />
    <SolidColorBrush x:Key="Control.MouseOver.Border" Color="#6A6A70" />
    <SolidColorBrush x:Key="Control.Pressed.Background" Color="#094771" />
    <SolidColorBrush x:Key="Control.Pressed.Border" Color="#1F8CD0" />
    <SolidColorBrush x:Key="Control.Disabled.Background" Color="#2A2A2C" />
    <SolidColorBrush x:Key="Control.Disabled.Foreground" Color="#767676" />
    <SolidColorBrush x:Key="Control.Disabled.Border" Color="#3A3A3D" />
    <SolidColorBrush x:Key="Control.Glyph" Color="#DCDCDC" />

    <!-- Text boxes -->
    <SolidColorBrush x:Key="TextBox.Static.Background" Color="#1B1B1C" />
    <SolidColorBrush x:Key="TextBox.Static.Foreground" Color="#E6E6E6" />
    <SolidColorBrush x:Key="TextBox.Static.Border" Color="#4A4A4F" />
    <SolidColorBrush x:Key="TextBox.Focus.Border" Color="#1F8CD0" />
    <SolidColorBrush x:Key="ReadOnlyTextBox.Static.Foreground" Color="#C8C8C8" />
    <SolidColorBrush x:Key="ReadOnlyTextBox.Static.Background" Color="#232324" />

    <!-- Titles and watermarks -->
    <SolidColorBrush x:Key="Title1.Foreground" Color="#DCDCDC" />
    <SolidColorBrush x:Key="Title2.Foreground" Color="#4EC9B0" />
    <SolidColorBrush x:Key="Watermark.Foreground" Color="#7A7A7A" />

    <!-- Group boxes -->
    <SolidColorBrush x:Key="GroupBox.Static.Border" Color="#4A4A4F" />

    <!-- Grid splitter -->
    <SolidColorBrush x:Key="GridSplitter.Static.Background" Color="#2D2D30" />
    <SolidColorBrush x:Key="GridSplitter.Static.Foreground" Color="#8A8A8A" />

    <!-- Menus -->
    <SolidColorBrush x:Key="Menu.Static.Background" Color="#2D2D30" />
    <SolidColorBrush x:Key="Menu.Static.Foreground" Color="#E6E6E6" />
    <SolidColorBrush x:Key="Menu.Popup.Background" Color="#2D2D30" />
    <SolidColorBrush x:Key="Menu.Popup.Border" Color="#4A4A4F" />
    <SolidColorBrush x:Key="Menu.Item.Highlight.Background" Color="#094771" />
    <SolidColorBrush x:Key="Menu.Item.Highlight.Foreground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Menu.Separator.Border" Color="#4A4A4F" />
    <SolidColorBrush x:Key="Menu.Disabled.Foreground" Color="#767676" />
    <SolidColorBrush x:Key="Menu.GestureText.Foreground" Color="#9A9A9A" />

    <!-- Popups (combo box drop downs, tool tips) -->
    <SolidColorBrush x:Key="Popup.Static.Background" Color="#2D2D30" />
    <SolidColorBrush x:Key="Popup.Static.Border" Color="#4A4A4F" />

    <!-- Items (tree view items, combo box items) -->
    <SolidColorBrush x:Key="Item.MouseOver.Background" Color="#3E3E42" />
    <SolidColorBrush x:Key="Item.Selected.Background" Color="#094771" />
    <SolidColorBrush x:Key="Item.Selected.Foreground" Color="#FFFFFF" />

    <!-- Status bar -->
    <SolidColorBrush x:Key="StatusBar.Static.Background" Color="#2D2D30" />
    <SolidColorBrush x:Key="StatusBar.Static.Foreground" Color="#E6E6E6" />

    <!-- Scroll bars -->
    <SolidColorBrush x:Key="ScrollBar.Static.Background" Color="#1E1E1E" />
    <SolidColorBrush x:Key="ScrollBar.Static.Thumb" Color="#4A4A4F" />
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Thumb" Color="#5F5F66" />
    <SolidColorBrush x:Key="ScrollBar.Pressed.Thumb" Color="#8A8A92" />
    <SolidColorBrush x:Key="ScrollBar.Glyph" Color="#B4B4B4" />
    <SolidColorBrush x:Key="ScrollViewer.Border.Brush" Color="#3F3F46" />

    <!-- Expanders -->
    <SolidColorBrush x:Key="Expander.Arrow.Static.Stroke" Color="#B4B4B4" />
    <SolidColorBrush x:Key="Expander.Arrow.MouseOver.Stroke" Color="#FFFFFF" />

    <!-- Tree view -->
    <SolidColorBrush x:Key="TreeViewItemIcon.Static.Error.Stroke" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Stroke" Color="#9A9A9A" />
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Fill" Color="Transparent" />
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Checked.Stroke" Color="#DCDCDC" />
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Checked.Fill" Color="#DCDCDC" />
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.ErrorInDescendants.Stroke" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.ErrorInDescendants.Fill" Color="Transparent" />
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Checked.ErrorInDescendants.Stroke" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Checked.ErrorInDescendants.Fill" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.MouseOver.Fill" Color="#6A6A70" />

    <!-- Icons -->
    <SolidColorBrush x:Key="HelpIcon.Static.Background" Color="#6E6B7B" />
    <SolidColorBrush x:Key="HelpIcon.Static.Foreground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="KeyIcon.Static.Background" Color="#4A4A4F" />
    <SolidColorBrush x:Key="KeyIcon.Static.WarningForeground" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="KeyIcon.Static.ErrorForeground" Color="{StaticResource ErrorColor}" />

    <!-- Progress bar -->
    <SolidColorBrush x:Key="ProgressBar.Static.Background" Color="#3A3A3D" />
    <LinearGradientBrush x:Key="ProgressBar.Progress.Foreground" StartPoint="0, 0.5" EndPoint="1, 0.5">
        <GradientStop Offset="0" Color="#CC19148F" />
        <GradientStop Offset="0.5" Color="#CC0099FF" />
        <GradientStop Offset="1" Color="#CC45DE6F" />
    </LinearGradientBrush>

    <!-- Play/Stop button -->
    <SolidColorBrush x:Key="PlayStopButton.Static.Border" Color="#4A4A4F" />
    <SolidColorBrush x:Key="PlayStopButton.Static.Background" Color="#3A3A3D" />
    <SolidColorBrush x:Key="PlayStopButton.MouseOver.Background" Color="#55555C" />
    <SolidColorBrush x:Key="PlayStopButton.Play.Icon" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="PlayStopButton.Stop.Icon" Color="#DC7D7D" />
    <SolidColorBrush x:Key="PlayStopButton.Cancelling.Icon" Color="#F2D24B" />

</ResourceDictionary>
