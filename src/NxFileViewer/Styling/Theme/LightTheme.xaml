<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         LIGHT THEME
         Every key defined here MUST also exist in DarkTheme.xaml.
         Always reference these keys with DynamicResource (never with
         StaticResource) otherwise live theme switching won't work.
         ============================================================ -->

    <Color x:Key="AccentColor">#51EBAB</Color>
    <Color x:Key="WarningColor">Orange</Color>
    <Color x:Key="ErrorColor">Red</Color>

    <!-- Fonts -->
    <SolidColorBrush x:Key="FontBrush.Default" Color="Black" />
    <SolidColorBrush x:Key="FontBrush.Success" Color="ForestGreen" />
    <SolidColorBrush x:Key="FontBrush.Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="FontBrush.Error" Color="{StaticResource ErrorColor}" />

    <!-- Windows and surfaces -->
    <SolidColorBrush x:Key="Window.Static.Background" Color="#F0F0F0" />
    <SolidColorBrush x:Key="Window.Static.Foreground" Color="#1C1C1C" />
    <SolidColorBrush x:Key="Surface.Static.Background" Color="White" />

    <!-- Generic controls -->
    <SolidColorBrush x:Key="Control.Static.Background" Color="#E5E5E5" />
    <SolidColorBrush x:Key="Control.Static.Foreground" Color="#1C1C1C" />
    <SolidColorBrush x:Key="Control.Static.Border" Color="#ACACAC" />
    <SolidColorBrush x:Key="Control.MouseOver.Background" Color="#D8ECFB" />
    <SolidColorBrush x:Key="Control.MouseOver.Border" Color="#5EA9DC" />
    <SolidColorBrush x:Key="Control.Pressed.Background" Color="#BEE3F7" />
    <SolidColorBrush x:Key="Control.Pressed.Border" Color="#3C88C0" />
    <SolidColorBrush x:Key="Control.Disabled.Background" Color="#EFEFEF" />
    <SolidColorBrush x:Key="Control.Disabled.Foreground" Color="#8D8D8D" />
    <SolidColorBrush x:Key="Control.Disabled.Border" Color="#D2D2D2" />
    <SolidColorBrush x:Key="Control.Glyph" Color="#4D4D4D" />

    <!-- Text boxes -->
    <SolidColorBrush x:Key="TextBox.Static.Background" Color="White" />
    <SolidColorBrush x:Key="TextBox.Static.Foreground" Color="#1C1C1C" />
    <SolidColorBrush x:Key="TextBox.Static.Border" Color="#ABADB3" />
    <SolidColorBrush x:Key="TextBox.Focus.Border" Color="#569DE5" />
    <SolidColorBrush x:Key="ReadOnlyTextBox.Static.Foreground" Color="#1C1C1C" />
    <SolidColorBrush x:Key="ReadOnlyTextBox.Static.Background" Color="White" />

    <!-- Titles and watermarks -->
    <SolidColorBrush x:Key="Title1.Foreground" Color="#3C3C3C" />
    <SolidColorBrush x:Key="Title2.Foreground" Color="DarkCyan" />
    <SolidColorBrush x:Key="Watermark.Foreground" Color="#9C9C9C" />

    <!-- Group boxes -->
    <SolidColorBrush x:Key="GroupBox.Static.Border" Color="#535353" />

    <!-- Grid splitter -->
    <SolidColorBrush x:Key="GridSplitter.Static.Background" Color="Gainsboro" />
    <SolidColorBrush x:Key="GridSplitter.Static.Foreground" Color="Gray" />

    <!-- Menus -->
    <SolidColorBrush x:Key="Menu.Static.Background" Color="#F0F0F0" />
    <SolidColorBrush x:Key="Menu.Static.Foreground" Color="#1C1C1C" />
    <SolidColorBrush x:Key="Menu.Popup.Background" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Menu.Popup.Border" Color="#999999" />
    <SolidColorBrush x:Key="Menu.Item.Highlight.Background" Color="#D8ECFB" />
    <SolidColorBrush x:Key="Menu.Item.Highlight.Foreground" Color="#1C1C1C" />
    <SolidColorBrush x:Key="Menu.Separator.Border" Color="#D2D2D2" />
    <SolidColorBrush x:Key="Menu.Disabled.Foreground" Color="#9A9A9A" />
    <SolidColorBrush x:Key="Menu.GestureText.Foreground" Color="#7A7A7A" />

    <!-- Popups (combo box drop downs, tool tips) -->
    <SolidColorBrush x:Key="Popup.Static.Background" Color="White" />
    <SolidColorBrush x:Key="Popup.Static.Border" Color="#ACACAC" />

    <!-- Items (tree view items, combo box items) -->
    <SolidColorBrush x:Key="Item.MouseOver.Background" Color="#D8ECFB" />
    <SolidColorBrush x:Key="Item.Selected.Background" Color="#BEE3F7" />
    <SolidColorBrush x:Key="Item.Selected.Foreground" Color="#1C1C1C" />

    <!-- Status bar -->
    <SolidColorBrush x:Key="StatusBar.Static.Background" Color="#F0F0F0" />
    <SolidColorBrush x:Key="StatusBar.Static.Foreground" Color="#1C1C1C" />

    <!-- Scroll bars -->
    <SolidColorBrush x:Key="ScrollBar.Static.Background" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ScrollBar.Static.Thumb" Color="#CDCDCD" />
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Thumb" Color="#A6A6A6" />
    <SolidColorBrush x:Key="ScrollBar.Pressed.Thumb" Color="#606060" />
    <SolidColorBrush x:Key="ScrollBar.Glyph" Color="#606060" />
    <SolidColorBrush x:Key="ScrollViewer.Border.Brush" Color="LightGray" />

    <!-- Expanders -->
    <SolidColorBrush x:Key="Expander.Arrow.Static.Stroke" Color="#666666" />
    <SolidColorBrush x:Key="Expander.Arrow.MouseOver.Stroke" Color="#222222" />

    <!-- Tree view -->
    <SolidColorBrush x:Key="TreeViewItemIcon.Static.Error.Stroke" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Stroke" Color="#FF818181" />
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Fill" Color="Transparent" />
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Checked.Stroke" Color="#FF262626" />
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Checked.Fill" Color="#FF595959" />
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.ErrorInDescendants.Stroke" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.ErrorInDescendants.Fill" Color="Transparent" />
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Checked.ErrorInDescendants.Stroke" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Checked.ErrorInDescendants.Fill" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="TreeViewItem.TreeArrow.MouseOver.Fill" Color="LightGray" />

    <!-- Icons -->
    <SolidColorBrush x:Key="HelpIcon.Static.Background" Color="#9D9AA8" />
    <SolidColorBrush x:Key="HelpIcon.Static.Foreground" Color="White" />
    <SolidColorBrush x:Key="KeyIcon.Static.Background" Color="#FF595959" />
    <SolidColorBrush x:Key="KeyIcon.Static.WarningForeground" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="KeyIcon.Static.ErrorForeground" Color="{StaticResource ErrorColor}" />

    <!-- Progress bar -->
    <SolidColorBrush x:Key="ProgressBar.Static.Background" Color="#686868" />
    <LinearGradientBrush x:Key="ProgressBar.Progress.Foreground" StartPoint="0, 0.5" EndPoint="1, 0.5">
        <GradientStop Offset="0" Color="#9919148F" />
        <GradientStop Offset="0.5" Color="#990099FF" />
        <GradientStop Offset="1" Color="#9945DE6F" />
    </LinearGradientBrush>

    <!-- Play/Stop button -->
    <SolidColorBrush x:Key="PlayStopButton.Static.Border" Color="#686868" />
    <SolidColorBrush x:Key="PlayStopButton.Static.Background" Color="#686868" />
    <SolidColorBrush x:Key="PlayStopButton.MouseOver.Background" Color="#8D8D99" />
    <SolidColorBrush x:Key="PlayStopButton.Play.Icon" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="PlayStopButton.Stop.Icon" Color="#DC7D7D" />
    <SolidColorBrush x:Key="PlayStopButton.Cancelling.Icon" Color="Yellow" />

</ResourceDictionary>
